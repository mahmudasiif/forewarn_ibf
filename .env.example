# ============ general ============
PROJECT_NAME=FOREWARN IBF Portal
ENVIRONMENT=development           # development | staging | production
TZ=Asia/Dhaka

# ============ database ============
# The password appears TWICE here — in POSTGRES_PASSWORD and again inside
# DATABASE_URL. They must match. Changing only one leaves the API logging in
# with the wrong password against a database created with the other, and
# every request fails on connect. Check them with:
#   grep -E '^(POSTGRES_PASSWORD|DATABASE_URL)=' .env
POSTGRES_USER=forewarn
POSTGRES_PASSWORD=change_me
POSTGRES_DB=forewarn
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://forewarn:change_me@db:5432/forewarn

# ============ redis / queue ============
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ============ object storage (MinIO / S3) ============
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=forewarn
S3_REGION=us-east-1

# ============ auth ============
SECRET_KEY=generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
ALGORITHM=HS256

# ============ api ============
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# ============ model services ============
CCM_SERVICE_URL=http://ccm:8000
MODEL_REQUEST_TIMEOUT=120

# --- preparedness guidance (Module 3) ---
PREPAREDNESS_SERVICE_URL=http://preparedness:8000
PREPAREDNESS_REQUEST_TIMEOUT=1200
# Gemini key(s) for guideline polishing — comma-separated for failover. Leave
# empty to run without LLM polish (impact + maps + base guideline still work).
GOOGLE_API_KEYS=
GEMINI_MODEL=gemini-2.0-flash
# Optional live web-context RAG (Phase 2). Leave empty to disable.
TAVILY_API_KEY=

# ============ frontend (build-time) ============
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_DEFAULT_CENTER=23.685,90.3563
VITE_DEFAULT_ZOOM=7
VITE_CCM_DASHBOARD_URL=/ccm/            # local dev: http://10.71.1.102:8088/ ; production: /ccm/ via nginx
