# --- project brain (local only) ---
# Every rule in this block is anchored with a leading slash so it matches ONLY
# at the repository root. Without the slash, git matches the pattern at any
# depth -- and because git on Windows sets core.ignorecase=true, a bare `CCM/`
# also matched `apps/api/app/modules/ccm/` and `services/ccm/`, silently
# dropping every NEW file in those modules from commits. (Already-tracked
# files kept committing, which is what made it so hard to see.) Keep the
# leading slash on anything in this block.
/Documents/
/Claude outputs/

# --- local tooling / vendored source drops (never commit) ---
/graphify-out/
/Cyclone-AI-Guideline-Handover/
/DFRM/
/GIS Layers/
/GIS_Layers/
/CCM/
/CCM_v2.9.3/

# stray root lockfile (there is no root package.json — the app lives in apps/web)
/package-lock.json

# --- env & secrets ---
.env
.env.*
!.env.example
infra/env/*.env
!infra/env/*.env.example

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --- node ---
node_modules/
dist/
build/
.vite/
*.tsbuildinfo
.pnpm-store/

# --- model weights & data ---
services/*/weights/*
!services/*/weights/.gitkeep
services/preparedness/assets/*
!services/preparedness/assets/.gitkeep
services/dfrm/assets/*
!services/dfrm/assets/.gitkeep
data/*
!data/README.md
*.nc
*.grib
*.grib2
*.tif
*.tiff

# --- docker / runtime ---
# daily FFWC water-level CSVs (worker output; also in MinIO)
ffwc/
.docker-data/
postgres-data/
minio-data/
redis-data/

# --- editors / os ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
